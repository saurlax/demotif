# Copy to .env and adjust as needed.
DEMOTIF_ENVIRONMENT=local
DEMOTIF_DATABASE_URL=sqlite+aiosqlite:///./data/demotif.db
DEMOTIF_MEDIA_ROOT=./data/media
DEMOTIF_EXAMPLES_ROOT=./data/examples
DEMOTIF_MAX_UPLOAD_BYTES=104857600

# Optional real producer: uv sync --extra producer
# Use chat for Chat Completions compatible gateways.
DEMOTIF_PRODUCER_API=responses
DEMOTIF_PRODUCER_MODEL_SETTINGS={}
DEMOTIF_PRODUCER_MODEL=
DEMOTIF_PRODUCER_BASE_URL=
DEMOTIF_PRODUCER_API_KEY=

# Optional asynchronous audio provider and local analysis
DEMOTIF_AUDIO_BASE_URL=
DEMOTIF_AUDIO_API_KEY=
DEMOTIF_AUDIO_BIZ_ID=
# uv sync --extra producer --extra analysis; install ffmpeg for audio processing
