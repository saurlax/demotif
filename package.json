{
  "name": "demotif",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-server.mjs --dev",
    "build": "npm run build:storage && npm run build:server && next build",
    "build:server": "node scripts/build-server.mjs",
    "build:storage": "esbuild scripts/storage.ts --bundle --platform=node --format=esm --packages=external --outfile=.storage/storage.mjs",
    "storage": "node .storage/storage.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "start": "node scripts/run-server.mjs",
    "typecheck": "tsc --noEmit",
    "migrate:local": "node scripts/migrate-local-data.mjs",
    "migrate:config": "node scripts/migrate-config.mjs",
    "dev:s3": "node scripts/local-s3.mjs",
    "dev:local": "node scripts/dev-local.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.108",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@base-ui/react": "^1.9.0",
    "@next/env": "^16.4.5",
    "@smithy/md5-js": "^4.5.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@tanstack/react-query": "^5.105.1",
    "ai": "^7.0.162",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.66.0",
    "modal": "^0.11.1",
    "next": "^16.4.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.16.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tencentcloud-sdk-nodejs-sts": "^4.1.100",
    "ws": "^8.22.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "s3rver": "^3.7.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
