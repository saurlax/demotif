# Server-only. Text Producer.
DEMOTIF_LLM_API_KEY=
DEMOTIF_LLM_BASE_URL=https://openrouter.ai/api/v1

# Server-only. StepAudio 3 Realtime voice.
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1

# Server-only. Direct ElevenLabs music, speech and audio tools.
DEMOTIF_ELEVENLABS_API_KEY=

# Optional editable score generation from the deployed YuE2 worker.
# Modal SDK reads MODAL_TOKEN_ID / MODAL_TOKEN_SECRET or the local Modal profile.
# DEMOTIF_YUE2_MODAL_APP=demotif
# DEMOTIF_YUE2_MODAL_ENVIRONMENT=main
# DEMOTIF_YUE2_MODAL_GPU=L40S

# Optional private CUDA worker for the non-commercial OpenCpop demo.
# DEMOTIF_SINGING_MODAL_APP=demotif-singing
# DEMOTIF_SINGING_MODAL_ENVIRONMENT=main
# DEMOTIF_SINGING_JA_MODAL_APP=demotif-singing-ja
# DEMOTIF_SINGING_JA_MODAL_ENVIRONMENT=main
# DEMOTIF_MEDIA_MODAL_APP=demotif-media
# DEMOTIF_MEDIA_MODAL_ENVIRONMENT=main

# Required only for object storage.
DEMOTIF_S3_ACCESS_KEY_ID=
DEMOTIF_S3_SECRET_ACCESS_KEY=

# Optional. Defaults to ./data.
# DEMOTIF_DATA_DIR=./data

# Local experiments: both S3 variables use the public S3rver test value S3RVER; see README.
