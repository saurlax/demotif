# All values are server-only; never prefix credentials with NEXT_PUBLIC_.
DEMOTIF_ENVIRONMENT=local
DEMOTIF_DATABASE_URL=sqlite:///./data/demotif.db
DEMOTIF_MEDIA_ROOT=./data/media
DEMOTIF_EXAMPLES_ROOT=./data/examples
DEMOTIF_MAX_UPLOAD_BYTES=104857600

DEMOTIF_PRODUCER_API=responses
DEMOTIF_PRODUCER_MODEL_SETTINGS={}
DEMOTIF_PRODUCER_MODEL=
DEMOTIF_PRODUCER_BASE_URL=
DEMOTIF_PRODUCER_API_KEY=

# Optional native singing; see workers/singing/README.md. No models are bundled.
# DEMOTIF_SINGING_PYTHON=/absolute/path/to/workers/singing/.venv/bin/python
# DEMOTIF_SINGING_MODELS_ROOT=./data/models
# DEMOTIF_SINGING_DEVICE=cpu
